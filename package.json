{
  "name": "@mp-consulting/homebridge-dolphin-pool-cleaner",
  "displayName": "Dolphin Pool Cleaner",
  "version": "1.0.12",
  "description": "Homebridge plugin for MyDolphin Plus pool cleaning robots (Maytronics)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "watch": "npm run build && npm link && nodemon",
    "copy:ui-kit": "mkdir -p homebridge-ui/public/lib && cp node_modules/@mp-consulting/homebridge-ui-kit/dist/kit.css homebridge-ui/public/lib/ && cp node_modules/@mp-consulting/homebridge-ui-kit/dist/kit.js homebridge-ui/public/lib/",
    "copy-assets": "mkdir -p ./dist/protocol && cp ./src/protocol/*.json ./dist/protocol/",
    "build": "npm run copy:ui-kit && rimraf ./dist && tsc && npm run copy-assets",
    "prepublishOnly": "npm run lint && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui"
  },
  "keywords": [
    "homebridge-plugin",
    "homebridge",
    "mydolphin",
    "mydolphin-plus",
    "maytronics",
    "dolphin",
    "pool",
    "pool-robot",
    "pool-cleaner",
    "robot-cleaner",
    "swimming-pool",
    "smart-home",
    "homekit",
    "apple-home",
    "iot",
    "automation"
  ],
  "author": "MP Consulting",
  "license": "MIT",
  "engines": {
    "node": "^20.0.0 || ^22.0.0 || ^24.0.0",
    "homebridge": "^1.8.0 || ^2.0.0-beta.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mp-consulting/homebridge-dolphin-pool-cleaner.git"
  },
  "bugs": {
    "url": "https://github.com/mp-consulting/homebridge-dolphin-pool-cleaner/issues"
  },
  "funding": {
    "type": "paypal",
    "url": "https://paypal.me/mickaelpalma"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.540.0",
    "@aws-sdk/client-iot": "^3.971.0",
    "@homebridge/plugin-ui-utils": "^1.0.3",
    "axios": "^1.6.0",
    "mqtt": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@mp-consulting/homebridge-ui-kit": "^1.0.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.2",
    "homebridge": "^2.0.0-beta.55",
    "homebridge-config-ui-x": "^5.19.0",
    "nodemon": "^3.1.11",
    "rimraf": "^6.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.1",
    "vitest": "^4.0.18"
  },
  "homebridge": {
    "pluginAlias": "DolphinPoolCleaner",
    "pluginType": "platform",
    "singular": true,
    "customUi": true
  },
  "files": [
    "dist",
    "homebridge-ui",
    "config.schema.json"
  ]
}
